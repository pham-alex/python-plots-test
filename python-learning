import pandas as pd
import matplotlib.pyplot as plt

# dataset generated by AI for the example
data = {
    "order_id": ["GOB-001", "GOB-002", "GOB-003", "GOB-004", "GOB-005", "GOB-006", "GOB-007", "GOB-008", "GOB-009", "GOB-010", "GOB-011", "GOB-012", "GOB-013", "GOB-014", "GOB-015"],
    "product": ["Dragon Hoodie", "Glowcap Mushroom Lamp", "Haunted Rubber Duck", "Mystery Snack Box", "Tiny Wizard Hat", "Potion Water Flask", "Self-Stirring Cauldron Mug", "Squeaky Bat Slippers", "Moon Cheese Sampler", "Emergency Glitter Kit", "Dragon Hoodie", "Mystery Snack Box", "Goblin Lunchbox", "Lucky Dice", "Glowcap Mushroom Lamp"],
    "category": ["Clothing", "Home Decor", "Toys", "Food", "Clothing", "Accessories", "Kitchen", "Clothing", "Food", "Party Supplies", "Clothing", "Food", "Accessories", "Toys", "Home Decor"],
    "price": [42.00, 24.99, 7.50, 12.99, 14.00, 18.50, 21.50, 26.50, 15.00, 9.99, 42.00, 12.99, 22.00, 8.99, 24.99],
    "quantity": [2, 1, 5, 3, 2, 4, 1, 2, 3, 6, 1, 4, 2, 5, 2],
    "sales_channel": ["Online", "In-store", "Pop-up Market", "Online", "In-store", "Online", "In-store", "Pop-up Market", "Online", "In-store", "Online", "In-store", "Online", "Pop-up Market", "In-store"],
    "payment_method": ["Credit Card", "Cash", "Digital Wallet", "Debit Card", "Credit Card", "Digital Wallet", "Cash", "Debit Card", "Credit Card", "Cash", "Debit Card", "Digital Wallet", "Credit Card", "Cash", "Debit Card"],
    "promotion": ["MAGIC15", "None", "Goblin10", "Weekend Deal", "None", "Goblin10", "MAGIC15", "None", "Weekend Deal", "Goblin10", "None", "MAGIC15", "Weekend Deal", "Goblin10", "None"],
    "salesperson": ["Moss", "Pickles", "Bramble", "Nibbles", "Juniper", "Moss", "Pickles", "Bramble", "Nibbles", "Juniper", "Moss", "Pickles", "Bramble", "Nibbles", "Juniper"],
    "customer_rating": [5, 4, 3, 5, 4, 5, 4, 2, 5, 3, 4, 5, 5, 3, 4]
}

df = pd.DataFrame(data)

# Calculate total sales for each order
df['total_sales'] = df['price'] * df['quantity']

# Group by category and calculate total sales
category_sales = df.groupby('category')['total_sales'].sum().reset_index()

# Sort the categories by total sales in descending order
category_sales = category_sales.sort_values(by='total_sales', ascending=False)

# Customizing the bar chart
plt.figure(figsize=(10, 6))
plt.bar(category_sales['category'], category_sales['total_sales'], color='mediumseagreen')

plt.title('Total Sales by Product Category')
plt.xlabel('Product Category')
plt.ylabel('Total Sales ($)')
plt.xticks(rotation=45)

# Show the chart
plt.tight_layout()
plt.show()

# Category vs. Payment Method Analysis
category_payment = df.groupby(['category', 'payment_method']).size().unstack()

category_payment.plot(kind='bar', figsize=(10, 6))

plt.title('Payment Methods by Product Category')
plt.xlabel('Category')
plt.ylabel('Number of Orders')
plt.xticks(rotation=45)
plt.legend(title='Payment Method')
plt.tight_layout()
plt.show()

#Category vs. Customer Rating Analysis
category_rating = df.groupby('category')['customer_rating'].mean().reset_index()

plt.figure(figsize=(9, 5))
plt.bar(category_rating['category'], category_rating['customer_rating'])

plt.title('Average Customer Rating by Category')
plt.xlabel('Category')
plt.ylabel('Average Rating')
plt.ylim(0, 5)
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()

#Quantity vs. Promotion Analysis
promotion_quantity = df.groupby('promotion')['quantity'].sum().reset_index()

plt.figure(figsize=(8, 5))
plt.bar(promotion_quantity['promotion'], promotion_quantity['quantity'])

plt.title('Quantity Sold by Promotion')
plt.xlabel('Promotion')
plt.ylabel('Total Quantity Sold')
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()

#Salesperson vs. Total Sales Analysis
salesperson_sales = df.groupby('salesperson')['total_sales'].sum().reset_index()

plt.figure(figsize=(8, 5))
plt.bar(salesperson_sales['salesperson'], salesperson_sales['total_sales'], color='coral')

plt.title('Total Sales by Salesperson')
plt.xlabel('Salesperson')
plt.ylabel('Total Sales ($)')
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()

#Percentage of orders made using each payment method
payment_counts = df['payment_method'].value_counts()

plt.figure(figsize=(7, 7))

plt.pie(
    payment_counts,
    labels=payment_counts.index,
    autopct='%1.1f%%',
    startangle=90
)

plt.title('Percentage of Orders by Payment Method')
plt.tight_layout()
plt.show()